# AI_API_KEY: API key for the LLM used to answer questions about ingredient lists.
AI_API_KEY="MY_AI_API_KEY"

# AI_MODEL: Model name to use for ingredient-list analysis.
# Defaults to deepseek-v3.2 via the Qianfan endpoint if not set.
AI_MODEL="deepseek-v3.2"

# AI_BASE_URL: Base URL for the LLM API.
# Defaults to the Qianfan endpoint if not set.
AI_BASE_URL="https://qianfan.baidubce.com/v2"

# AI_APP_ID: App ID required by some providers (e.g. Qianfan).
AI_APP_ID="MY_AI_APP_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Path to the SQLite database file.
# Defaults to ./data/verifyvoice.db if not set.
DATABASE_URL="./data/verifyvoice.db"

# Tencent Cloud COS credentials.
# If any of these are missing, uploaded pictures will be stored on the local disk instead.
COS_SECRET_ID="MY_COS_SECRET_ID"
COS_SECRET_KEY="MY_COS_SECRET_KEY"
COS_BUCKET="MY_COS_BUCKET"
COS_REGION="ap-guangzhou"

# COS_PREFIX: Optional prefix/folder for uploaded images inside the bucket.
COS_PREFIX="verifyvoice/images"

# COS_CDN_URL: Optional CDN base URL (e.g. https://cdn.example.com).
# If omitted, the default COS domain will be used.
COS_CDN_URL=""
